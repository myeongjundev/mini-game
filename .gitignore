# Local secrets and environment
.env
.env.*
!.env.example

# Dependencies and build output
node_modules/
dist/
build/
.cache/

# Public deploy output is built by CI, not committed.
# vite의 emptyOutDir가 매 빌드마다 이 폴더를 비우므로 자리표시 파일도 두지 않는다.
site/

# Logs and browser test artifacts
*.log
playwright-report/
test-results/
coverage/

# Private evidence originals stay local unless explicitly reviewed
evidence/*
!evidence/.gitkeep

# 캡처 원본. evidence/와 같은 이유로 제외한다 — 화면에 무엇이 찍혔는지는
# 찍어보고 열어봐야 알 수 있어서, 공개 저장소에 자동으로 올리지 않는다.
실행 이미지/

# 제출 PDF 생성 결과와 작업 폴더. site/와 같은 이유로 제외한다 — 스크립트가
# 다시 만드는 산출물이고, 그 안에 캡처가 합쳐져 들어간다.
# README에 넣은 화면은 docs/screenshots/에 한 장씩 확인하고 따로 두었다.
output/
tmp/

# Operating system and editor files
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
